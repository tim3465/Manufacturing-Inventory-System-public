{
	"info": {
		"name": "CncApp - Machines",
		"description": "Collection for testing the Machines API endpoints: creating, listing, retrieving, inactivating, and listing all machines.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://localhost:7136",
			"type": "string"
		},
		{
			"key": "machineId",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "POST Create Machine",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"serialNumber\": \"SN-001\",\n  \"modelNumber\": \"MX-100\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": "{{baseUrl}}/api/machines"
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"  pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response has id and sets machineId\", function () {",
							"  const jsonData = pm.response.json();",
							"  pm.expect(jsonData).to.have.property(\"id\");",
							"  pm.collectionVariables.set(\"machineId\", jsonData.id);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "GET List Active Machines",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/machines"
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"  pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "GET Get Machine By Id",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/machines/{{machineId}}"
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"  pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "DELETE Inactivate Machine",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": "{{baseUrl}}/api/machines/{{machineId}}"
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 204\", function () {",
							"  pm.response.to.have.status(204);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		},
		{
			"name": "GET List All Machines",
			"request": {
				"method": "GET",
				"header": [],
				"url": "{{baseUrl}}/api/machines/all"
			},
			"response": [],
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"  pm.response.to.have.status(200);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			]
		}
	]
}


