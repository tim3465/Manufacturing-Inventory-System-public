{
  "info": {
    "name": "Shifts - Smoke Tests",
    "description": "End-to-end smoke tests for Shifts slice. Run in order: Auth → Create → Get → ListActive → ListAll → Inactivate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "shifts-smoke-tests-20260108-1200"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7136", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "shiftId", "value": "", "type": "string" },
    { "key": "jobId", "value": "1", "type": "string" },
    { "key": "operatorId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Login (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@local.test\",\n  \"password\": \"Admin123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Response has accessToken\", function () {",
                  "  pm.expect(jsonData).to.have.property(\"accessToken\");",
                  "  pm.collectionVariables.set(\"accessToken\", jsonData.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Shifts - Create",
      "item": [
        {
          "name": "POST Create Shift",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jobId\": {{jobId}},\n  \"operatorId\": {{operatorId}},\n  \"barsConsumed\": 1,\n  \"partsMade\": 5,\n  \"scrap\": 0,\n  \"partsPerBar\": 2,\n  \"startTime\": \"{{timestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/shifts", "host": ["{{baseUrl}}"], "path": ["api", "shifts"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Response has id\", function () {",
                  "  pm.expect(jsonData).to.have.property(\"id\");",
                  "  pm.collectionVariables.set(\"shiftId\", jsonData.id.toString());",
                  "});",
                  "pm.test(\"Location header is present\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Location\")).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Shifts - Get",
      "item": [
        {
          "name": "GET Shift by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/shifts/{{shiftId}}", "host": ["{{baseUrl}}"], "path": ["api", "shifts", "{{shiftId}}"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Response has Shift data\", function () {",
                  "  pm.expect(jsonData).to.have.property(\"id\");",
                  "  pm.expect(jsonData).to.have.property(\"jobId\");",
                  "  pm.expect(jsonData).to.have.property(\"operatorId\");",
                  "  pm.expect(jsonData).to.have.property(\"barsConsumed\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET Shift - Non-existent (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/shifts/99999", "host": ["{{baseUrl}}"], "path": ["api", "shifts", "99999"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test(\"Status code is 404\", function () { pm.response.to.have.status(404); });"],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Shifts - ListActive",
      "item": [
        {
          "name": "GET List Active Shifts",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/shifts", "host": ["{{baseUrl}}"], "path": ["api", "shifts"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Response is an array\", function () { pm.expect(jsonData).to.be.an('array'); });",
                  "pm.test(\"Created shift is in list\", function () {",
                  "  const id = parseInt(pm.collectionVariables.get(\"shiftId\"));",
                  "  const found = jsonData.find(item => item.id === id);",
                  "  pm.expect(found).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Shifts - ListAll",
      "item": [
        {
          "name": "GET List All Shifts (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/shifts/all", "host": ["{{baseUrl}}"], "path": ["api", "shifts", "all"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Response is an array\", function () { pm.expect(jsonData).to.be.an('array'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Shifts - Inactivate",
      "item": [
        {
          "name": "PATCH Inactivate Shift",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/shifts/{{shiftId}}/inactivate", "host": ["{{baseUrl}}"], "path": ["api", "shifts", "{{shiftId}}", "inactivate"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test(\"Status code is 204\", function () { pm.response.to.have.status(204); });"], "type": "text/javascript" }
            }
          ]
        },
        {
          "name": "PATCH Inactivate Shift - Non-existent (404)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }],
            "url": { "raw": "{{baseUrl}}/api/shifts/99999/inactivate", "host": ["{{baseUrl}}"], "path": ["api", "shifts", "99999", "inactivate"] }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test(\"Status code is 404\", function () { pm.response.to.have.status(404); });"], "type": "text/javascript" }
            }
          ]
        }
      ]
    }
  ]
}

