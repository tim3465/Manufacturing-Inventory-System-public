									"pm.test(\"Created material is in list\", function () {",
									"  const jsonData = pm.response.json();",
									"  const materialId = parseInt(pm.collectionVariables.get(\"materialId\"));",
									"  const found = jsonData.find(item => item.id === materialId);",
									"  pm.expect(found).to.exist;",
									"});"
								],
